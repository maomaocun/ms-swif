# Copy this file to a private shell snippet, edit the values, then source it:
#
#   cp training_script/env.example /mnt/cpfs/YOUR_TEAM/sft/env.qwen36.sh
#   source /mnt/cpfs/YOUR_TEAM/sft/env.qwen36.sh
#
# Keep secrets out of this repository. Put W&B keys in CPFS secrets or inject
# them through the DLC console/RAM role environment.

# Fill this after saving/pushing the image.
export IMAGE_URI=""

# Local repository path when testing with docker. For DLC, prefer the CPFS repo
# path if the job should run code mounted from CPFS.
export REPO_DIR="/mnt/workspace/ms-swif"

# CPFS layout. Change this root to your durable training area.
export SFT_CPFS_ROOT="/mnt/cpfs/YOUR_TEAM/sft"
export SFT_MODEL_PATH="/mnt/cpfs/public_data/public_model/Qwen3.6/Qwen3.6-27B"
export SFT_DATASET_PATH="${SFT_CPFS_ROOT}/datasets/paper2arm/paper2arm_dsv4pro_sft_reward_ge_0.6.jsonl"
export SFT_OUTPUT_ROOT="${SFT_CPFS_ROOT}/outputs/qwen36-27b"
export SFT_LOG_ROOT="${SFT_CPFS_ROOT}/logs/qwen36-27b"
export SFT_CACHE_ROOT="${SFT_CPFS_ROOT}/cache/qwen36-27b"

# Runtime reporting. Use REPORT_TO=wandb only after WANDB_API_KEY or
# WANDB_API_KEY_FILE is available to the container.
export SFT_REPORT_TO="none"
export SFT_WANDB_PROJECT="train_distillation"
export SFT_WANDB_ENTITY=""
export SFT_WANDB_API_KEY_FILE="${SFT_CPFS_ROOT}/secrets/wandb_api_key"

# Megatron defaults for Qwen3.6 27B. Keep CP=1 for the current gated_delta_net
# path unless the training stack is updated and verified.
export SFT_NPROC_PER_NODE="8"
export SFT_TENSOR_MODEL_PARALLEL_SIZE="8"
export SFT_PIPELINE_MODEL_PARALLEL_SIZE="4"
export SFT_CONTEXT_PARALLEL_SIZE="1"
export SFT_GLOBAL_BATCH_SIZE="8"
export SFT_MICRO_BATCH_SIZE="1"
export SFT_MAX_LENGTH="262144"
export SFT_LINEAR_CE_CHUNK_SIZE="2048"
